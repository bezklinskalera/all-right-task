{
  "name": "all-right-task",
  "version": "1.0.0",
  "private": true,
  "description": "UI (saucedemo) and API (restful-booker) automated tests with Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:saucedemo": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
